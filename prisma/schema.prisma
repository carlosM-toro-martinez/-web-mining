generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

////////////////////////////////
// SISTEMA
////////////////////////////////

model Configuracion {
  id           Int          @id @default(autoincrement())
  metodoCosteo MetodoCosteo @default(ULTIMO_PRECIO)
  createdAt    DateTime     @default(now())
}

model User {
  id                         Int                      @id @default(autoincrement())
  nombre                     String
  email                      String                   @unique
  password                   String
  role                       Role
  createdAt                  DateTime                 @default(now())
  resetToken                 String?
  resetTokenExpiry           DateTime?
  refreshToken               String?
  refreshTokenExpiry         DateTime?
  activo                     Boolean                  @default(true)
  comprasRecibidas           Compra[]                 @relation("UsuarioRecibe")
  comprasRegistradas         Compra[]                 @relation("UsuarioRegistro")
  anulacionesCompra          AnulacionCompra[]
  eppAsignaciones            EppAsignacion[]
  logs                       Log[]
  movimientosEntregados      Movimiento[]             @relation("UsuarioEntrega")
  movimientos                Movimiento[]             @relation("UsuarioRegistro")
  movimientosRecibidos       Movimiento[]             @relation("UsuarioRecibido")
  valesEntregadosPor         Vale[]                   @relation("Almacenero")
  valesSolicitados           Vale[]                   @relation("Solicitante")
  valesAprobados             Vale[]                   @relation("Supervisor")
  anulaciones                AnulacionVale[]
  registrosHidricos          RegistroHidrico[]
  registrosResiduo           RegistroResiduo[]
  registrosRuido             RegistroRuido[]
  registrosSuelo             RegistroSuelo[]
  manifiestos                ManifiestoAmbiental[]
  estadosFlotaHistorico      EstadoFlotaHistorico[]
  lotesRegistrados           LoteDespacho[]           @relation("UsuarioRegistroLote")
  pesajesIngenio             PesajeIngenio[]
  anulacionesLote            AnulacionLote[]
  liquidacionesRegistradas   LiquidacionPeriodo[]
  anulacionesLiquidacion     AnulacionLiquidacion[]
  cajasChicasEncargadas      CajaChica[]
  gastosCajaRegistrados      GastoCaja[]
  anulacionesGastoCaja       AnulacionGastoCaja[]
  movimientosFondoCaja       MovimientoFondoCaja[]
  rendicionesCajaRegistradas RendicionCaja[]
  anulacionesRendicionCaja   AnulacionRendicionCaja[]
  movimientosBancoCaja       MovimientoBancoCaja[]
}

model Log {
  id        String   @id @default(uuid())
  usuarioId Int?
  accion    String
  data      Json
  createdAt DateTime @default(now())
  usuario   User?    @relation(fields: [usuarioId], references: [id])
}

////////////////////////////////
// INVENTARIO
////////////////////////////////

////////////////////////////////
// CONTABILIDAD
////////////////////////////////

model CentroCosto {
  id      Int              @id @default(autoincrement())
  codigo  String           @unique
  nombre  String
  cuentas CuentaContable[]
}

model FuncionGasto {
  id      Int              @id @default(autoincrement())
  codigo  String           @unique
  nombre  String
  cuentas CuentaContable[]
}

model Sector {
  id      Int              @id @default(autoincrement())
  codigo  String           @unique
  nombre  String
  cuentas CuentaContable[]
}

model CuentaContable {
  id             Int          @id @default(autoincrement())
  codigoCompleto String       @unique
  centroCostoId  Int
  funcionGastoId Int
  sectorId       Int?
  centroCosto    CentroCosto  @relation(fields: [centroCostoId], references: [id])
  funcionGasto   FuncionGasto @relation(fields: [funcionGastoId], references: [id])
  sector         Sector?      @relation(fields: [sectorId], references: [id])
  movimientos    Movimiento[]
  productos      Producto[]
  remitentes     Remitente[]
}

model CategoriaInventario {
  id        Int                   @id @default(autoincrement())
  codigo    String
  nombre    String
  parentId  Int?
  parent    CategoriaInventario?  @relation("Tree", fields: [parentId], references: [id])
  children  CategoriaInventario[] @relation("Tree")
  productos Producto[]
}

model Producto {
  id              Int                 @id @default(autoincrement())
  codigo          String              @unique
  nombre          String
  unidad          String
  categoriaId     Int
  esEpp           Boolean             @default(false)
  cuentaId        Int?
  compraItems     CompraItem[]
  eppAsignaciones EppAsignacion[]
  movimientos     Movimiento[]
  pedidoItems     PedidoItem[]
  saldosMensuales SaldoMensual[]
  categoria       CategoriaInventario @relation(fields: [categoriaId], references: [id])
  cuenta          CuentaContable?     @relation(fields: [cuentaId], references: [id])
  stock           Stock?
  valeItems       ValeItem[]
}

model SaldoMensual {
  id             String   @id @default(uuid())
  productoId     Int
  anio           Int
  mes            Int
  saldoInicial   Decimal  @default(0) @db.Decimal(14, 4)
  ingresoQty     Decimal  @default(0) @db.Decimal(14, 4)
  salidaQty      Decimal  @default(0) @db.Decimal(14, 4)
  saldoFinal     Decimal  @default(0) @db.Decimal(14, 4)
  precioUnit     Decimal  @default(0) @db.Decimal(14, 4) // último precio de compra del período
  totalBs        Decimal  @default(0) @db.Decimal(14, 4) // saldoFinal × precioUnit
  totalBsInicial Decimal? @db.Decimal(14, 2) // override manual del monto inicial en Bs
  ingresosBs     Decimal  @default(0) @db.Decimal(14, 4) // suma(cantidad × precioUnit) de todas las entradas → para calcular promedio
  precioUnitProm Decimal  @default(0) @db.Decimal(14, 6) // promedio ponderado = ingresosBs / ingresoQty
  totalBsProm    Decimal  @default(0) @db.Decimal(14, 6) // saldoFinal × precioUnitProm
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  producto       Producto @relation(fields: [productoId], references: [id])

  @@unique([productoId, anio, mes])
  @@index([anio, mes])
}

model Stock {
  id                Int      @id @default(autoincrement())
  productoId        Int      @unique
  cantidad          Decimal  @db.Decimal(12, 2)
  cantidadReservada Decimal  @default(0) @db.Decimal(12, 2)
  precioUnit        Decimal  @db.Decimal(14, 6)
  precioProm        Decimal  @db.Decimal(14, 6)
  updatedAt         DateTime @updatedAt
  producto          Producto @relation(fields: [productoId], references: [id])
}

model Movimiento {
  id                String          @id @default(uuid())
  operationId       String          @unique
  productoId        Int
  tipo              TipoMovimiento
  cantidad          Decimal         @db.Decimal(12, 2)
  precioUnit        Decimal         @db.Decimal(14, 6)
  entradaBs         Decimal         @default(0) @db.Decimal(12, 2)
  salidaBs          Decimal         @default(0) @db.Decimal(12, 2)
  saldoBs           Decimal         @db.Decimal(12, 2)
  stockAntes        Decimal         @db.Decimal(12, 2)
  stockDespues      Decimal         @db.Decimal(12, 2)
  usuarioId         Int
  cuentaId          Int?
  referencia        String?
  referenciaId      String?
  esRetroactivo     Boolean         @default(false)
  periodoAnio       Int?
  periodoMes        Int?
  createdAt         DateTime        @default(now())
  usuarioEntregaId  Int?
  usuarioRecibidoId Int?
  cuenta            CuentaContable? @relation(fields: [cuentaId], references: [id])
  producto          Producto        @relation(fields: [productoId], references: [id])
  usuarioEntrega    User?           @relation("UsuarioEntrega", fields: [usuarioEntregaId], references: [id])
  usuario           User            @relation("UsuarioRegistro", fields: [usuarioId], references: [id])
  usuarioRecibido   User?           @relation("UsuarioRecibido", fields: [usuarioRecibidoId], references: [id])
}

////////////////////////////////
// COMPRAS
////////////////////////////////

model Proveedor {
  id          Int      @id @default(autoincrement())
  nombre      String
  contacto    String?
  lugar       String?
  nit         String?
  razonSocial String?
  compras     Compra[]
  pedidos     Pedido[]
}

model Pedido {
  id          String       @id @default(uuid())
  proveedorId Int
  estado      EstadoPedido
  createdAt   DateTime     @default(now())
  observacion String?
  proveedor   Proveedor    @relation(fields: [proveedorId], references: [id])
  items       PedidoItem[]
}

model PedidoItem {
  id               String   @id @default(uuid())
  pedidoId         String
  productoId       Int
  cantidadPedida   Decimal  @db.Decimal(12, 2)
  cantidadRecibida Decimal  @default(0) @db.Decimal(12, 2)
  pedido           Pedido   @relation(fields: [pedidoId], references: [id])
  producto         Producto @relation(fields: [productoId], references: [id])
}

model Compra {
  id                String           @id @default(uuid())
  proveedorId       Int
  estado            EstadoCompra
  createdAt         DateTime         @default(now())
  observacion       String?
  numeroFactura     String?
  descuento         Decimal          @default(0) @db.Decimal(5, 2)
  recibidoAt        DateTime?
  fechaOperacion    DateTime?
  usuarioRecibidoId Int?
  usuarioRegistroId Int
  tieneIva          Boolean          @default(true)
  esGasEspecial     Boolean?
  proveedor         Proveedor        @relation(fields: [proveedorId], references: [id])
  usuarioRecibe     User?            @relation("UsuarioRecibe", fields: [usuarioRecibidoId], references: [id])
  usuarioRegistro   User             @relation("UsuarioRegistro", fields: [usuarioRegistroId], references: [id])
  items             CompraItem[]
  anulacion         AnulacionCompra?
}

model CompraItem {
  id               String   @id @default(uuid())
  compraId         String
  productoId       Int
  cantidadPedida   Decimal  @db.Decimal(12, 2)
  cantidadRecibida Decimal  @default(0) @db.Decimal(12, 2)
  precioUnit       Decimal  @db.Decimal(14, 6)
  totalBs          Decimal? @db.Decimal(14, 2)
  compra           Compra   @relation(fields: [compraId], references: [id])
  producto         Producto @relation(fields: [productoId], references: [id])
}

////////////////////////////////
// VALES / EPP
////////////////////////////////

model Vale {
  id                String         @id @default(uuid())
  solicitanteId     Int
  superintendenteId Int?
  estado            EstadoVale
  aprobadoAt        DateTime?
  entregadoAt       DateTime?
  fechaOperacion    DateTime?
  createdAt         DateTime       @default(now())
  almaceneroId      Int?
  almacenero        User?          @relation("Almacenero", fields: [almaceneroId], references: [id])
  solicitante       User           @relation("Solicitante", fields: [solicitanteId], references: [id])
  superintendente   User?          @relation("Supervisor", fields: [superintendenteId], references: [id])
  items             ValeItem[]
  anulacion         AnulacionVale?
}

model AnulacionVale {
  id        String   @id @default(uuid())
  valeId    String   @unique
  usuarioId Int
  motivo    String
  createdAt DateTime @default(now())
  vale      Vale     @relation(fields: [valeId], references: [id])
  usuario   User     @relation(fields: [usuarioId], references: [id])
}

model AnulacionCompra {
  id        String   @id @default(uuid())
  compraId  String   @unique
  usuarioId Int
  motivo    String
  createdAt DateTime @default(now())
  compra    Compra   @relation(fields: [compraId], references: [id])
  usuario   User     @relation(fields: [usuarioId], references: [id])
}

model ValeItem {
  id                 String   @id @default(uuid())
  valeId             String
  productoId         Int
  cantidadSolicitada Decimal  @db.Decimal(12, 2)
  cantidadEntregada  Decimal  @default(0) @db.Decimal(12, 2)
  producto           Producto @relation(fields: [productoId], references: [id])
  vale               Vale     @relation(fields: [valeId], references: [id])
}

model EppAsignacion {
  id              String       @id @default(uuid())
  productoId      Int
  usuarioId       Int
  fechaEntrega    DateTime     @default(now())
  fechaDevolucion DateTime?
  condicion       CondicionEpp @default(EN_USO)
  observacion     String?
  producto        Producto     @relation(fields: [productoId], references: [id])
  usuario         User         @relation(fields: [usuarioId], references: [id])

  @@index([productoId])
  @@index([usuarioId])
}

////////////////////////////////
// AMBIENTAL
////////////////////////////////

model PuntoMonitoreo {
  id          Int       @id @default(autoincrement())
  nombre      String
  descripcion String?
  latitud     Float
  longitud    Float
  tipo        TipoPunto @default(GENERAL)
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  registrosHidricos RegistroHidrico[]
  registrosResiduo  RegistroResiduo[]
  registrosRuido    RegistroRuido[]
  registrosSuelo    RegistroSuelo[]

  @@index([tipo])
}

model RegistroHidrico {
  id                Int         @id @default(autoincrement())
  puntoId           Int
  fecha             DateTime
  ph                Float?
  turbidez          Float?
  conductividad     Float?
  oxigenoDisuelto   Float?
  temperatura       Float?
  coliformesFecales Float?
  calidadAgua       CalidadAgua @default(BUENA)
  observaciones     String?
  usuarioId         Int
  createdAt         DateTime    @default(now())

  punto   PuntoMonitoreo @relation(fields: [puntoId], references: [id])
  usuario User           @relation(fields: [usuarioId], references: [id])

  @@index([puntoId])
  @@index([fecha])
}

model RegistroResiduo {
  id            Int         @id @default(autoincrement())
  puntoId       Int?
  fecha         DateTime
  tipoResiduo   TipoResiduo
  cantidad      Float
  unidad        String
  disposicion   String
  empresa       String?
  manifiestoNum String?
  observaciones String?
  usuarioId     Int
  createdAt     DateTime    @default(now())

  punto   PuntoMonitoreo? @relation(fields: [puntoId], references: [id])
  usuario User            @relation(fields: [usuarioId], references: [id])

  @@index([puntoId])
  @@index([fecha])
}

model RegistroRuido {
  id              Int      @id @default(autoincrement())
  puntoId         Int
  fecha           DateTime
  nivelRuido      Float
  limitePermitido Float?
  particulasPm10  Float?
  particulasPm25  Float?
  observaciones   String?
  usuarioId       Int
  createdAt       DateTime @default(now())

  punto   PuntoMonitoreo @relation(fields: [puntoId], references: [id])
  usuario User           @relation(fields: [usuarioId], references: [id])

  @@index([puntoId])
  @@index([fecha])
}

model RegistroSuelo {
  id                  Int      @id @default(autoincrement())
  puntoId             Int
  fecha               DateTime
  ph                  Float?
  conductividad       Float?
  materiaOrganica     Float?
  especiesRegistradas String?
  observaciones       String?
  usuarioId           Int
  createdAt           DateTime @default(now())

  punto   PuntoMonitoreo @relation(fields: [puntoId], references: [id])
  usuario User           @relation(fields: [usuarioId], references: [id])

  @@index([puntoId])
  @@index([fecha])
}

model PozoSeptico {
  id              Int                   @id @default(autoincrement())
  nombre          String
  descripcion     String?
  latitud         Float
  longitud        Float
  capacidadM3     Float?
  estado          EstadoInfraestructura @default(BUENO)
  ultimaLimpieza  DateTime?
  proximaLimpieza DateTime?
  observaciones   String?
  activo          Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model ManifiestoAmbiental {
  id          Int       @id @default(autoincrement())
  anio        Int
  titulo      String
  descripcion String?
  objetivos   String?
  compromisos String?
  responsable String?
  aprobadoAt  DateTime?
  usuarioId   Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  usuario User @relation(fields: [usuarioId], references: [id])

  @@index([anio])
}

////////////////////////////////
// BIOMÉTRICO / ASISTENCIA
////////////////////////////////

model Employee {
  id           Int                @id @default(autoincrement())
  nombre       String
  documento    String?            @unique
  cargo        String?
  tipoPersonal TipoPersonal       @default(OBRERO)
  deviceUserId String             @unique
  activo       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  syncStatus   SyncStatus         @default(PENDING)
  logs         AsistenciaLog[]
  horarios     EmpleadoHorario[]
  ausencias    AusenciaEmpleado[]
}

model Horario {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  horaEntrada String // "HH:MM" hora local Bolivia
  horaSalida  String // "HH:MM" hora local Bolivia
  tolerancia  Int      @default(15) // minutos de tolerancia para tardanza
  lunes       Boolean  @default(true)
  martes      Boolean  @default(true)
  miercoles   Boolean  @default(true)
  jueves      Boolean  @default(true)
  viernes     Boolean  @default(true)
  sabado      Boolean  @default(false)
  domingo     Boolean  @default(false)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  asignaciones EmpleadoHorario[]
}

model EmpleadoHorario {
  id         Int       @id @default(autoincrement())
  employeeId Int
  horarioId  Int
  desde      DateTime // fecha desde la que aplica este horario
  hasta      DateTime? // null = vigente actualmente
  createdAt  DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  horario  Horario  @relation(fields: [horarioId], references: [id])

  @@index([employeeId])
  @@index([horarioId])
}

model AusenciaEmpleado {
  id         Int          @id @default(autoincrement())
  employeeId Int
  tipo       AusenciaTipo
  desde      DateTime // inicio del período (fecha, hora ignorada)
  hasta      DateTime // fin del período inclusivo (fecha, hora ignorada)
  motivo     String?
  aprobado   Boolean      @default(false)
  creadoPor  String? // nombre o ID del que aprueba
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([desde, hasta])
}

model SyncQueue {
  id        Int        @id @default(autoincrement())
  action    SyncAction
  payload   Json
  status    SyncStatus @default(PENDING)
  deviceIp  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model DeviceState {
  sn        String   @id
  lastSeen  DateTime
  updatedAt DateTime @updatedAt
}

model CierreMes {
  id        Int      @id @default(autoincrement())
  anio      Int
  mes       Int
  usuarioId Int
  creadoAt  DateTime @default(now())

  @@unique([anio, mes])
}

model AsistenciaLog {
  id           Int       @id @default(autoincrement())
  employeeId   Int?
  deviceUserId String
  fecha        DateTime
  tipo         String
  employee     Employee? @relation(fields: [employeeId], references: [id])

  @@unique([deviceUserId, fecha])
  @@index([fecha])
  @@index([employeeId])
}

////////////////////////////////
// ENUMS
////////////////////////////////

enum MetodoCosteo {
  ULTIMO_PRECIO
  PROMEDIO_PONDERADO
}

enum Role {
  ADMIN
  ALMACENERO
  SUPERINTENDENTE
  TRABAJADOR
  VISITANTE
  GEOLOGOADMIN
  GEOLOGO
  ADMINISTRADOR
  MEDIOAMBIENTE
  SEGURIDAD
  ASISTENTE_ADMINISTRATIVO
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
}

enum EstadoPedido {
  PENDIENTE
  PARCIAL
  COMPLETADO
}

enum EstadoCompra {
  PENDIENTE
  PARCIAL
  COMPLETADO
  ANULADA
}

enum EstadoVale {
  PENDIENTE
  APROBADO
  PARCIAL
  COMPLETADO
  RECHAZADO
  ANULADO
}

enum SyncStatus {
  PENDING
  SYNCED
  ERROR
}

enum TipoPersonal {
  OBRERO
  TECNICO_EMPLEADO
}

enum SyncAction {
  CREATE
  UPDATE
  DELETE
}

enum AusenciaTipo {
  VACACION
  DESCANSO
  PERMISO
  ENFERMEDAD
  FERIADO
  ABANDONO
  OTRO
}

enum CondicionEpp {
  NUEVO
  EN_USO
  DEVUELTO_BUENO
  DEVUELTO_USADO
  BAJA
}

enum TipoPunto {
  HIDRICO
  SUELO
  RUIDO
  RESIDUOS
  POZO_SEPTICO
  GENERAL
}

enum CalidadAgua {
  EXCELENTE
  BUENA
  REGULAR
  MALA
  CRITICA
}

enum TipoResiduo {
  SOLIDO_PELIGROSO
  SOLIDO_NO_PELIGROSO
  LIQUIDO_PELIGROSO
  LIQUIDO_NO_PELIGROSO
}

enum EstadoInfraestructura {
  BUENO
  REGULAR
  MALO
  CRITICO
}

////////////////////////////////
// LOGÍSTICA, ACOPIO Y LIQUIDACIÓN
// (Fase 1: catálogos parametrizables. Los modelos núcleo —
// Remitente, Vehiculo, LoteDespacho, LiquidacionPeriodo, etc. —
// se agregan en fases posteriores y añaden sus relaciones inversas
// a estos catálogos en ese momento.)
////////////////////////////////

model MunicipioOrigen {
  id     Int     @id @default(autoincrement())
  codigo String  @unique
  nombre String
  activo Boolean @default(true)

  alicuotas     AlicuotaRegalia[]
  remitentes    Remitente[]
  lotesDespacho LoteDespacho[]
}

model TipoMineral {
  id     Int     @id @default(autoincrement())
  codigo String  @unique
  nombre String
  activo Boolean @default(true)

  alicuotas     AlicuotaRegalia[]
  tarifas       TarifaLiquidacion[]
  lotesDespacho LoteDespacho[]
}

model Ingenio {
  id     Int     @id @default(autoincrement())
  codigo String  @unique
  nombre String
  activo Boolean @default(true)

  lotesDespacho LoteDespacho[]
}

model AlicuotaRegalia {
  id                Int             @id @default(autoincrement())
  municipioOrigenId Int
  tipoMineralId     Int
  porcentaje        Decimal         @db.Decimal(5, 2)
  vigenteDesde      DateTime
  vigenteHasta      DateTime?
  municipioOrigen   MunicipioOrigen @relation(fields: [municipioOrigenId], references: [id])
  tipoMineral       TipoMineral     @relation(fields: [tipoMineralId], references: [id])

  @@index([municipioOrigenId, tipoMineralId])
}

model TarifaLiquidacion {
  id                Int                  @id @default(autoincrement())
  tipoEntidad       TipoEntidadRemitente
  tipoMineralId     Int?
  precioPorTonelada Decimal              @db.Decimal(14, 6)
  vigenteDesde      DateTime
  vigenteHasta      DateTime?
  tipoMineral       TipoMineral?         @relation(fields: [tipoMineralId], references: [id])

  @@index([tipoEntidad, tipoMineralId])
}

model ConceptoLiquidacion {
  id     Int                     @id @default(autoincrement())
  nombre String
  tipo   TipoConceptoLiquidacion
  activo Boolean                 @default(true)

  items LiquidacionItemConcepto[]
}

enum TipoEntidadRemitente {
  EMPRESA
  TRABAJADOR_PARTICULAR
}

enum TipoConceptoLiquidacion {
  ABONO
  DEDUCCION
}

////////////////////////////////
// LOGÍSTICA — Fase 2: Remitente y Flota
// (Vehiculo/Chofer no tienen relaciones hacia LoteDespacho todavía;
// esa relación inversa se agrega en la Fase 3.)
////////////////////////////////

model Remitente {
  id                 Int                  @id @default(autoincrement())
  tipoEntidad        TipoEntidadRemitente
  nombreORazonSocial String
  nitOCi             String
  municipioId        Int?
  cuentaContableId   Int?
  activo             Boolean              @default(true)

  municipio      MunicipioOrigen?     @relation(fields: [municipioId], references: [id])
  cuentaContable CuentaContable?      @relation(fields: [cuentaContableId], references: [id])
  vehiculos      Vehiculo[]
  lotesDespacho  LoteDespacho[]
  liquidaciones  LiquidacionPeriodo[]

  @@index([municipioId])
  @@index([cuentaContableId])
}

model Vehiculo {
  id            Int            @id @default(autoincrement())
  placa         String         @unique
  tipo          String
  capacidadTon  Decimal        @db.Decimal(8, 2)
  propietarioId Int?
  estadoActual  EstadoVehiculo @default(DISPONIBLE)
  activo        Boolean        @default(true)

  propietario      Remitente?             @relation(fields: [propietarioId], references: [id])
  historialEstados EstadoFlotaHistorico[]
  lotesDespacho    LoteDespacho[]

  @@index([propietarioId])
}

model Chofer {
  id       Int     @id @default(autoincrement())
  nombre   String
  ci       String  @unique
  licencia String?
  activo   Boolean @default(true)

  lotesDespacho LoteDespacho[]
}

model EstadoFlotaHistorico {
  id           String            @id @default(uuid())
  vehiculoId   Int
  estado       EstadoVehiculo
  motivo       String?
  origenCambio OrigenCambioFlota @default(MANUAL)
  usuarioId    Int
  createdAt    DateTime          @default(now())

  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id])
  usuario  User     @relation(fields: [usuarioId], references: [id])

  @@index([vehiculoId])
}

enum EstadoVehiculo {
  DISPONIBLE
  EN_TRANSITO
  EN_BALANZA
  CON_FALLA_MECANICA
  EN_MANTENIMIENTO
}

enum OrigenCambioFlota {
  MANUAL
  API_GPS
}

////////////////////////////////
// LOGÍSTICA — Fase 3: Lotes de despacho (núcleo operativo)
// Patrón de anulación lógica idéntico a Compra/Vale: nunca se borra,
// el estado final ANULADO + AnulacionLote conservan la trazabilidad
// del correlativo para auditoría municipal/fiscal.
////////////////////////////////

model LoteDespacho {
  id                    String              @id @default(uuid())
  correlativo           String              @unique
  municipioOrigenId     Int
  remitenteId           Int
  vehiculoId            Int
  choferId              Int
  tipoMineralId         Int
  destinoIngenioId      Int
  nivel                 String?
  fechaDespachoReal     DateTime
  fechaDocumentalFiscal DateTime
  codigoFormulario101   String?
  estadoFormulario101   EstadoFormulario101 @default(PENDIENTE)
  estadoLote            EstadoLoteDespacho  @default(REGISTRADO)
  usuarioRegistroId     Int
  createdAt             DateTime            @default(now())

  municipioOrigen MunicipioOrigen @relation(fields: [municipioOrigenId], references: [id])
  remitente       Remitente       @relation(fields: [remitenteId], references: [id])
  vehiculo        Vehiculo        @relation(fields: [vehiculoId], references: [id])
  chofer          Chofer          @relation(fields: [choferId], references: [id])
  tipoMineral     TipoMineral     @relation(fields: [tipoMineralId], references: [id])
  destinoIngenio  Ingenio         @relation(fields: [destinoIngenioId], references: [id])
  usuarioRegistro User            @relation("UsuarioRegistroLote", fields: [usuarioRegistroId], references: [id])

  conocimientoCarga   ConocimientoCarga?
  pesaje              PesajeIngenio?
  anulacion           AnulacionLote?
  detallesLiquidacion LiquidacionDetalleLote[]

  @@index([municipioOrigenId])
  @@index([remitenteId])
  @@index([vehiculoId])
  @@index([estadoLote])
}

// Un lote = un conocimiento: usa el mismo correlativo del lote como
// número de documento, así que no lleva un campo de numeración propio.
model ConocimientoCarga {
  id             String   @id @default(uuid())
  loteId         String   @unique
  copiasEmitidas Json
  createdAt      DateTime @default(now())

  lote LoteDespacho @relation(fields: [loteId], references: [id])
}

model PesajeIngenio {
  id            String   @id @default(uuid())
  loteId        String   @unique
  tonelajeBruto Decimal  @db.Decimal(10, 3)
  tonelajeTara  Decimal  @db.Decimal(10, 3)
  tonelajeNeto  Decimal  @db.Decimal(10, 3)
  fechaPesaje   DateTime @default(now())
  usuarioId     Int
  createdAt     DateTime @default(now())

  lote    LoteDespacho @relation(fields: [loteId], references: [id])
  usuario User         @relation(fields: [usuarioId], references: [id])
}

model AnulacionLote {
  id        String   @id @default(uuid())
  loteId    String   @unique
  usuarioId Int
  motivo    String
  createdAt DateTime @default(now())

  lote    LoteDespacho @relation(fields: [loteId], references: [id])
  usuario User         @relation(fields: [usuarioId], references: [id])
}

model CorrelativoContador {
  id           String   @id @default(uuid())
  clave        String   @unique
  ultimoNumero Int      @default(0)
  updatedAt    DateTime @updatedAt
}

enum EstadoLoteDespacho {
  REGISTRADO
  EN_TRANSITO
  EN_BALANZA
  PESADO
  ACOPIADO
  LIQUIDADO
  ANULADO
}

enum EstadoFormulario101 {
  PENDIENTE
  REGULARIZADO
}

////////////////////////////////
// LOGÍSTICA — Fase 4: Liquidaciones
// Mismo patrón de anulación lógica; anular una liquidación CERRADA
// revierte los lotes incluidos de vuelta a ACOPIADO para que puedan
// re-liquidarse correctamente.
////////////////////////////////

model LiquidacionPeriodo {
  id               String                 @id @default(uuid())
  remitenteId      Int
  tipoPeriodo      TipoPeriodoLiquidacion
  fechaInicio      DateTime
  fechaFin         DateTime
  estado           EstadoLiquidacion      @default(BORRADOR)
  totalBruto       Decimal                @default(0) @db.Decimal(14, 2)
  totalAbonos      Decimal                @default(0) @db.Decimal(14, 2)
  totalDeducciones Decimal                @default(0) @db.Decimal(14, 2)
  totalNeto        Decimal                @default(0) @db.Decimal(14, 2)
  usuarioId        Int
  createdAt        DateTime               @default(now())

  remitente     Remitente                 @relation(fields: [remitenteId], references: [id])
  usuario       User                      @relation(fields: [usuarioId], references: [id])
  detalleLotes  LiquidacionDetalleLote[]
  itemsConcepto LiquidacionItemConcepto[]
  anulacion     AnulacionLiquidacion?

  @@index([remitenteId])
  @@index([estado])
}

model LiquidacionDetalleLote {
  id             String  @id @default(uuid())
  liquidacionId  String
  loteId         String
  tonelajeNeto   Decimal @db.Decimal(10, 3)
  precioAplicado Decimal @db.Decimal(14, 6)
  subtotal       Decimal @db.Decimal(14, 2)

  liquidacion LiquidacionPeriodo @relation(fields: [liquidacionId], references: [id])
  lote        LoteDespacho       @relation(fields: [loteId], references: [id])

  @@index([liquidacionId])
  @@index([loteId])
}

model LiquidacionItemConcepto {
  id            String  @id @default(uuid())
  liquidacionId String
  conceptoId    Int
  descripcion   String?
  monto         Decimal @db.Decimal(14, 2)

  liquidacion LiquidacionPeriodo  @relation(fields: [liquidacionId], references: [id])
  concepto    ConceptoLiquidacion @relation(fields: [conceptoId], references: [id])

  @@index([liquidacionId])
}

model AnulacionLiquidacion {
  id            String   @id @default(uuid())
  liquidacionId String   @unique
  usuarioId     Int
  motivo        String
  createdAt     DateTime @default(now())

  liquidacion LiquidacionPeriodo @relation(fields: [liquidacionId], references: [id])
  usuario     User               @relation(fields: [usuarioId], references: [id])
}

enum TipoPeriodoLiquidacion {
  SEMANAL
  MENSUAL
}

enum EstadoLiquidacion {
  BORRADOR
  CERRADO
  ANULADO
}

////////////////////////////////
// LOGÍSTICA — Fase 5: cierre mensual del Cuadro Municipal
// Mismo patrón minimalista que CierreMes (sin @relation en usuarioId):
// solo bloquea la re-generación del cuadro de un municipio+mes ya cerrado.
////////////////////////////////

model CierreLogisticaMensual {
  id          Int      @id @default(autoincrement())
  municipioId Int
  anio        Int
  mes         Int
  usuarioId   Int
  createdAt   DateTime @default(now())

  @@unique([municipioId, anio, mes])
}

////////////////////////////////
// CAJA CHICA / RENDICIÓN DE CUENTAS DE CAMPAMENTO
// Fase 1: catálogos propios, separados de CentroCosto/FuncionGasto/
// CuentaContable de Inventario (se unifican más adelante si hace falta).
// Núcleo (GastoCaja, RendicionCaja) se agrega en fases posteriores y
// añade sus relaciones inversas a estos catálogos en ese momento.
////////////////////////////////

model CajaChica {
  id                 Int        @id @default(autoincrement())
  codigo             String     @unique
  nombre             String
  monedaBase         MonedaCaja @default(BOB)
  // Cuánto había en esta caja al momento de empezar a usar el sistema (antes
  // de eso no hay movimientos registrados aquí). El saldo actual siempre
  // parte de este número, no de cero.
  saldoInicial       Decimal    @default(0) @db.Decimal(14, 2)
  encargadoNombre    String?
  encargadoUsuarioId Int?
  activo             Boolean    @default(true)

  encargadoUsuario User?                 @relation(fields: [encargadoUsuarioId], references: [id])
  gastos           GastoCaja[]
  movimientosFondo MovimientoFondoCaja[]
  rendiciones      RendicionCaja[]
  movimientosBanco MovimientoBancoCaja[]
  presupuestos     PresupuestoCaja[]
}

// Nota: el PDF fuente de Centro de Costo no trae columna de tipo D/N
// (a diferencia de Función de Gasto), por eso este modelo no tiene `tipo`.
model CentroCostoCaja {
  id       Int     @id @default(autoincrement())
  codigo   String  @unique
  nombre   String
  parentId Int?
  activo   Boolean @default(true)

  parent   CentroCostoCaja?  @relation("CentroCostoCajaTree", fields: [parentId], references: [id])
  children CentroCostoCaja[] @relation("CentroCostoCajaTree")
  gastos   GastoCaja[]
}

model FuncionGastoCaja {
  id       Int            @id @default(autoincrement())
  codigo   String         @unique
  nombre   String
  tipo     TipoCosteoCaja
  parentId Int?
  activo   Boolean        @default(true)

  parent   FuncionGastoCaja?  @relation("FuncionGastoCajaTree", fields: [parentId], references: [id])
  children FuncionGastoCaja[] @relation("FuncionGastoCajaTree")
  gastos   GastoCaja[]
}

model CuentaContableCaja {
  id                   Int             @id @default(autoincrement())
  codigo               String          @unique
  nombre               String
  clase                ClaseCuentaCaja
  nivel                Int
  monedaCodigo         String
  requiereCentroCosto  Boolean         @default(false)
  requiereFuncionGasto Boolean         @default(false)
  activo               Boolean         @default(true)

  conceptosRetencion ConceptoRetencionCaja[]
  gastos             GastoCaja[]
}

model ConceptoRetencionCaja {
  id                   Int               @id @default(autoincrement())
  codigo               TipoRetencionCaja @unique
  nombre               String
  porcentaje           Decimal           @db.Decimal(5, 2)
  cuentaContableCajaId Int
  activo               Boolean           @default(true)

  cuentaContableCaja CuentaContableCaja @relation(fields: [cuentaContableCajaId], references: [id])
}

enum MonedaCaja {
  BOB
  USD
}

enum TipoCosteoCaja {
  DISTRIBUIBLE
  NO_DISTRIBUIBLE
}

enum ClaseCuentaCaja {
  BAL
  IND
  MAY
}

// Solo 3 conceptos reales: RC-IVA para servicios sin factura (cuenta
// 69.005.000, cuyo propio nombre en el Plan de Cuentas es "RC-IVA
// Retenciones Servicios"), IUE para compras/alimentación (69.006.000),
// e IT que aplica a ambos casos (69.007.000). No existe un "IUE Servicios"
// separado en la práctica contable real de esta empresa.
enum TipoRetencionCaja {
  RC_IVA
  IUE_COMPRAS
  IT
}

////////////////////////////////
// CAJA CHICA — Fase 2: núcleo (registro de gastos y fondos)
// Mismo patrón de anulación lógica que el resto del sistema.
////////////////////////////////

// Un gasto normalmente sale de una caja física (origen CAJA), pero algunos
// pagos se hacen directo desde el banco sin pasar por ninguna caja chica
// (origen BANCO) — ej. una transferencia directa a un proveedor. Por eso
// cajaId es opcional y hay un cuentaBancariaCajaId alternativo; el service
// exige exactamente uno de los dos según `origen`. Los gastos BANCO no
// entran a ninguna Rendición (esas son siempre por caja).
enum OrigenGastoCaja {
  CAJA
  BANCO
}

model GastoCaja {
  id                       String                   @id @default(uuid())
  cajaId                   Int?
  cuentaBancariaCajaId     Int?
  origen                   OrigenGastoCaja          @default(CAJA)
  fecha                    DateTime
  tipoDocumento            TipoDocumentoGasto
  categoriaRetencion       CategoriaRetencionGasto?
  categoriaRendicion       CategoriaRendicionGasto  @default(OTROS)
  proveedorNombre          String
  proveedorNitCi           String?
  glosa                    String
  numeroRespaldo           String?
  montoTotal               Decimal                  @db.Decimal(14, 2)
  moneda                   MonedaCaja
  centroCostoCajaId        Int
  funcionGastoCajaId       Int
  cuentaContableCajaId     Int?
  partidaPresupuestoId     Int?
  montoCreditoFiscalIva    Decimal                  @default(0) @db.Decimal(14, 2)
  montoRetencionRcIva      Decimal                  @default(0) @db.Decimal(14, 2)
  montoRetencionIueCompras Decimal                  @default(0) @db.Decimal(14, 2)
  montoRetencionIt         Decimal                  @default(0) @db.Decimal(14, 2)
  esNoDeducible            Boolean                  @default(false)
  estado                   EstadoGastoCaja          @default(REGISTRADO)
  usuarioId                Int
  createdAt                DateTime                 @default(now())

  caja               CajaChica?              @relation(fields: [cajaId], references: [id])
  cuentaBancariaCaja CuentaBancariaCaja?     @relation(fields: [cuentaBancariaCajaId], references: [id])
  centroCostoCaja    CentroCostoCaja         @relation(fields: [centroCostoCajaId], references: [id])
  funcionGastoCaja   FuncionGastoCaja        @relation(fields: [funcionGastoCajaId], references: [id])
  cuentaContableCaja CuentaContableCaja?     @relation(fields: [cuentaContableCajaId], references: [id])
  partidaPresupuesto PartidaPresupuestoCaja? @relation(fields: [partidaPresupuestoId], references: [id])
  usuario            User                    @relation(fields: [usuarioId], references: [id])
  anulacion          AnulacionGastoCaja?
  rendicionDetalle   RendicionDetalleGasto[]

  @@index([cajaId])
  @@index([cuentaBancariaCajaId])
  @@index([estado])
  @@index([fecha])
}

model AnulacionGastoCaja {
  id        String   @id @default(uuid())
  gastoId   String   @unique
  usuarioId Int
  motivo    String
  createdAt DateTime @default(now())

  gasto   GastoCaja @relation(fields: [gastoId], references: [id])
  usuario User      @relation(fields: [usuarioId], references: [id])
}

model MovimientoFondoCaja {
  id         String                  @id @default(uuid())
  cajaId     Int
  tipo       TipoMovimientoFondoCaja
  monto      Decimal                 @db.Decimal(14, 2)
  moneda     MonedaCaja
  fecha      DateTime
  referencia String?
  usuarioId  Int
  createdAt  DateTime                @default(now())

  caja    CajaChica @relation(fields: [cajaId], references: [id])
  usuario User      @relation(fields: [usuarioId], references: [id])

  @@index([cajaId])
}

enum TipoDocumentoGasto {
  FACTURA
  CONTRATO_RETENCION
  RECIBO_DIRECTO
}

enum CategoriaRetencionGasto {
  SERVICIO
  COMPRA
}

// Categorías de agrupación del reporte mensual de rendición (formato "Caja
// Lipeña" real de la empresa) — no son lo mismo que FuncionGastoCaja ni
// CentroCostoCaja: son la clasificación informal que usa el reporte impreso
// para armar subtotales (Materiales y Suministros, Transportes, etc.).
enum CategoriaRendicionGasto {
  MATERIALES_SUMINISTROS
  TRANSPORTES
  ACTIVOS_FIJOS
  MANTENIMIENTO_SERVICIOS
  OBLIGACIONES_SOCIALES
  OBRAS_CONSTRUCCION
  GASTOS_ADMINISTRATIVOS
  OTROS_GASTOS_ADMINISTRATIVOS
  OTROS
  MEDIO_AMBIENTE
}

enum EstadoGastoCaja {
  REGISTRADO
  RENDIDO
  ANULADO
}

enum TipoMovimientoFondoCaja {
  REMESA_PRESUPUESTO
  REMESA_SUELDOS
  REMESA_OTROS
  REPOSICION
}

////////////////////////////////
// CAJA CHICA — Fase 3: Rendiciones
// Estructura calcada de los reportes reales de Caja Lipeña (Fondos
// recibidos, Total gastos en el mes, Saldo deudor/acreedor) en vez de
// un libro mayor de partida doble completo — ver plan de la Fase 3.
// Mismo patrón de anulación con reversión que LiquidacionPeriodo en
// el módulo de Logística.
////////////////////////////////

model RendicionCaja {
  id                 String              @id @default(uuid())
  cajaId             Int
  periodoDesde       DateTime
  periodoHasta       DateTime
  // No es @unique a nivel de tabla: el folio "P-N/AAAA" se calcula solo a
  // partir del mes del período (ver generarFolioRendicionCaja), así que una
  // rendición ANULADA de ese mismo mes deja el mismo folio "atrapado" para
  // siempre si esto fuera único global. La regla real ("un folio activo por
  // caja y mes") se valida en el service, ignorando las anuladas.
  numero             String
  tipoCambio         Decimal             @db.Decimal(10, 4)
  estado             EstadoRendicionCaja @default(BORRADOR)
  totalFondos        Decimal             @default(0) @db.Decimal(14, 2)
  totalGastos        Decimal             @default(0) @db.Decimal(14, 2)
  totalRetenciones   Decimal             @default(0) @db.Decimal(14, 2)
  totalCreditoFiscal Decimal             @default(0) @db.Decimal(14, 2)
  saldoAnterior      Decimal             @default(0) @db.Decimal(14, 2)
  saldoNuevo         Decimal             @default(0) @db.Decimal(14, 2)
  usuarioId          Int
  createdAt          DateTime            @default(now())

  caja          CajaChica               @relation(fields: [cajaId], references: [id])
  usuario       User                    @relation(fields: [usuarioId], references: [id])
  detalleGastos RendicionDetalleGasto[]
  anulacion     AnulacionRendicionCaja?

  @@index([cajaId])
  @@index([estado])
}

model RendicionDetalleGasto {
  id            String  @id @default(uuid())
  rendicionId   String
  gastoId       String
  montoIncluido Decimal @db.Decimal(14, 2)

  rendicion RendicionCaja @relation(fields: [rendicionId], references: [id])
  gasto     GastoCaja     @relation(fields: [gastoId], references: [id])

  // gastoId NO es único global: al anular una rendición, el gasto vuelve a
  // REGISTRADO y puede quedar incluido en una rendición distinta más
  // adelante — cada intento deja su propia fila aquí. Lo único que no puede
  // repetirse es el mismo gasto dos veces DENTRO de la misma rendición.
  @@unique([rendicionId, gastoId])
  @@index([rendicionId])
  @@index([gastoId])
}

model AnulacionRendicionCaja {
  id          String   @id @default(uuid())
  rendicionId String   @unique
  usuarioId   Int
  motivo      String
  createdAt   DateTime @default(now())

  rendicion RendicionCaja @relation(fields: [rendicionId], references: [id])
  usuario   User          @relation(fields: [usuarioId], references: [id])
}

enum EstadoRendicionCaja {
  BORRADOR
  CERRADO
  ANULADO
}

////////////////////////////////
// CAJA CHICA — Fase 4: Banco y Presupuesto por partida
// El presupuesto mensual llega primero a una cuenta bancaria (ahí entran
// depósitos de presupuesto, sueldos, etc.); de ahí se transfiere a la caja
// chica por cheque (con su número) o transferencia. Cada gasto puede
// imputarse a una partida de presupuesto específica (ej. "Internet: 6000
// Bs este mes") para saber cuánto queda a favor — igual a la "Planilla de
// Control de Pagos" real.
////////////////////////////////

model CuentaBancariaCaja {
  id           Int        @id @default(autoincrement())
  banco        String
  numeroCuenta String?
  nombreCuenta String
  monedaBase   MonedaCaja @default(BOB)
  // Cuánto había en esta cuenta bancaria al empezar a usar el sistema. El
  // saldo actual = saldoInicial + ingresos registrados - salidas hacia cajas.
  saldoInicial Decimal    @default(0) @db.Decimal(14, 2)
  activo       Boolean    @default(true)

  movimientos MovimientoBancoCaja[]
  gastos      GastoCaja[]
}

// Un "presupuesto" (remesa) agrupa varias partidas de detalle bajo un mismo
// nombre — ej. "Remesa Presupuesto Octubre" (Internet, combustible, ...),
// "Remesa para pago de salarios" (sueldo de fulano, de mengano, ...),
// "Remesa para pago de varios" — todas del mismo mes y caja, pero
// independientes entre sí. Cada una se asigna a un banco UNA sola vez
// (asignadoMovimientoBancoId queda fijo apenas se aprueba, así el botón de
// "aprobar y asignar" no se puede volver a presionar para la misma remesa).
model PresupuestoCaja {
  id        Int      @id @default(autoincrement())
  cajaId    Int
  anio      Int
  mes       Int
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  asignadoMovimientoBancoId String?   @unique
  asignadoEn                DateTime?

  caja                    CajaChica            @relation(fields: [cajaId], references: [id])
  asignadoMovimientoBanco MovimientoBancoCaja? @relation(fields: [asignadoMovimientoBancoId], references: [id])
  partidas                PartidaPresupuestoCaja[]

  @@index([cajaId, anio, mes])
}

model PartidaPresupuestoCaja {
  id                 Int      @id @default(autoincrement())
  presupuestoId      Int
  descripcion        String
  montoPresupuestado Decimal  @db.Decimal(14, 2)
  activo             Boolean  @default(true)
  createdAt          DateTime @default(now())

  presupuesto PresupuestoCaja @relation(fields: [presupuestoId], references: [id])
  gastos      GastoCaja[]

  @@index([presupuestoId])
}

// El presupuesto vive a nivel de remesa (PresupuestoCaja), no a nivel de
// cada transferencia bancaria: mover dinero del banco hacia una caja fondea
// la caja en general, no una partida puntual. Por eso este movimiento NO se
// vincula a una partida — solo el GastoCaja (el gasto real) se imputa a una
// partida específica, y una remesa completa se vincula a UN movimiento
// cuando se aprueba y asigna al banco (ver PresupuestoCaja arriba).
model MovimientoBancoCaja {
  id               String              @id @default(uuid())
  cuentaBancariaId Int
  // INGRESO = dinero que llega a la cuenta bancaria (presupuesto, sueldos,
  // etc. — sin caja destino). SALIDA_A_CAJA = dinero que sale del banco
  // hacia una caja chica (con caja destino obligatoria).
  tipo              TipoMovimientoBanco @default(SALIDA_A_CAJA)
  cajaId            Int?
  fecha             DateTime
  formaPago         FormaPagoBanco
  numeroCheque      String?
  monto             Decimal             @db.Decimal(14, 2)
  moneda            MonedaCaja
  depositanteNombre String?
  descripcion       String
  usuarioId         Int
  createdAt         DateTime            @default(now())

  cuentaBancaria      CuentaBancariaCaja @relation(fields: [cuentaBancariaId], references: [id])
  caja                CajaChica?         @relation(fields: [cajaId], references: [id])
  usuario             User               @relation(fields: [usuarioId], references: [id])
  presupuestosAsignados PresupuestoCaja[]

  @@index([cajaId])
  @@index([cuentaBancariaId])
}

enum TipoMovimientoBanco {
  INGRESO
  SALIDA_A_CAJA
}

enum FormaPagoBanco {
  DEPOSITO
  CHEQUE
  TRANSFERENCIA
}
